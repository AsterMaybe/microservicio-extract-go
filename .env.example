# ── Red compartida ───────────────────────────────────────────────────────────
# Debe ser la misma red externa que usan docker-compose.db/app/traefik de
# pdfextract. Ahí viven mongo y el gateway Traefik.
SHARED_NETWORK_NAME=test_network

# ── Traefik / ruteo ─────────────────────────────────────────────────────────
# Host que Traefik usa para enrutar hacia este microservicio (router Rule).
# Usá un host distinto al del monolito (api.localhost) para no pisar sus rutas.
MICROSERVICE_HOST=extract.localhost

# ── MongoDB (credenciales compartidas con pdfextract) ────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=password

# Colección propia: no reutilices `extracted_texts` (schema del monolito).
GO_MONGODB_DB=pdf_extraction
GO_MONGODB_COLLECTION=extractions

# ── Redis (caché de extracciones, en la red compartida con pdfextract) ────────
# El servicio cachea por SHA-256 del binario del PDF. Un hit devuelve 200 sin
# volver a parsear. La instancia se define en pdfextract/docker-compose.db.yml.
REDIS_URL=redis://redis:6379
# Vida de cada entrada de caché (default 24h).
CACHE_TTL=24h

# ── Aplicación ───────────────────────────────────────────────────────────────
GIN_MODE=release
# Tamaño máximo del PDF en megabytes (default 25). Por encima, 413
# problem+json (type /too-large).
MAX_UPLOAD_MB=25
# Cuerpos de PDF que se pueden tener en RAM a la vez. Es el techo de memoria
# del servicio: MAX_IN_FLIGHT * MAX_UPLOAD_MB. Un request ya admitido espera
# aquí su turno en lugar de ser rechazado de inmediato.
MAX_IN_FLIGHT=32
# Extracciones simultáneas (0 = una por core de CPU). Los hits de caché no
# ocupan slot, sólo los misses. Valores negativos se rechazan al arrancar.
CONCURRENCY=5
# COLA ACOTADA: peticiones que pueden esperar turno antes de leerse. Se toma
# antes de leer el body, así que un request encolado no sujeta bytes del PDF y
# por eso puede ser holgadamente mayor que MAX_IN_FLIGHT. Si está llena, las
# siguientes se rechazan al instante con 429 sin esperar.
QUEUE_SIZE=200
# Tiempo máximo de espera (por un hueco de RAM o por un slot de parseo) antes
# de descartar con 429. Tiene que ser menor que EXTRACTION_TIMEOUT: son
# presupuestos distintos, la admisión acota la espera y la extracción el
# parseo. Encolar más sólo convierte carga en latencia.
ADMISSION_TIMEOUT=2s
# Límite de una sola ida y vuelta a Redis, para que una caché colgada cueste
# un timeout y no una petición que se queda esperando.
REDIS_TIMEOUT=2s
# Límite del parseo en sí, una vez que el request tiene su slot.
EXTRACTION_TIMEOUT=30s