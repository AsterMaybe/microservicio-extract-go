# Red Docker compartida por los 4 Compose.
SHARED_NETWORK_NAME=test_network
# Host del router de Traefik.
MICROSERVICE_HOST=extract.localhost
# Redis compartido (caché de extracciones).
REDIS_URL=redis://redis:6379
# Vida de cada entrada de caché.
CACHE_TTL=24h
# Modo de Gin (release o debug).
GIN_MODE=release
# Tamaño máximo de subida en MB.
MAX_UPLOAD_MB=25
# Subidas en RAM a la vez.
MAX_IN_FLIGHT=8
# Extracciones simultáneas (0 = una por core).
CONCURRENCY=1
# Techo blando del heap de Go.
GOMEMLIMIT=850MiB
# Frecuencia del GC de Go (100 = default).
GOGC=150
# Peticiones en espera antes de un 429.
QUEUE_SIZE=200
# Espera máxima por un slot (menor que EXTRACTION_TIMEOUT).
ADMISSION_TIMEOUT=15s
# Timeout de una ida y vuelta a Redis.
REDIS_TIMEOUT=2s
# Límite del parseo.
EXTRACTION_TIMEOUT=30s